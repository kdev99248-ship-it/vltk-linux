# Copy to .env and fill in, then run: deploy/vps-deploy.sh up
#
# The PUBLIC IP (or DNS-resolved IP) of your VPS. This is the address remote
# clients will connect to. deploy/vps-deploy.sh writes it into the game
# .cfg/.ini files (bishop/goddess/relay/game + the in-game server list).
PUBLIC_IP=

# SSH port of the VPS. Used only by `vps-deploy.sh firewall --harden-host`
# so it never locks you out. Change if your SSH is not on 22.
SSH_PORT=22

# OPTIONAL. Comma-separated client source IPs allowed to reach the game ports
# (5622,5623,5632,6666). Leave EMPTY to open the game ports to everyone
# (public play). If set, `vps-deploy.sh firewall` installs an iptables
# allowlist so only these IPs can connect.
#   Example: ALLOW_CLIENT_IPS=203.0.113.5,198.51.100.20
ALLOW_CLIENT_IPS=
